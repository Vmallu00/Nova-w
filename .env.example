# ==============================
# FakePixel Minecraft
# ==============================

MC_HOST=mc.fakepixel.me
MC_PORT=25565
MC_VERSION=1.8.9

# Default password for Minecraft bot accounts
DEFAULT_MC_PASSWORD=vmallu

# Default target island username
DEFAULT_TARGET=

# ==============================
# Web Panel
# ==============================

PORT=9000

PANEL_USERNAME=vmallu
PANEL_PASSWORD=vmallu

# ==============================
# FakePixel locations
# ==============================

MAIN_SPAWN_X=-52.500
MAIN_SPAWN_Y=95.74244
MAIN_SPAWN_Z=0.500

SKYBLOCK_HUB_X=-2.500
SKYBLOCK_HUB_Y=70.06250
SKYBLOCK_HUB_Z=-68.000

LOCATION_TOLERANCE=5

# ==============================
# AFK
# ==============================

DEFAULT_DURATION_HOURS=2

DEFAULT_MOVE_INTERVAL=10000
DEFAULT_JUMP_INTERVAL=2500

AFK_MOVE_DISTANCE=4

# ==============================
# Reconnect
# ==============================

AUTO_RECONNECT=true
RECONNECT_DELAY=5000

# Mineflayer keep-alive timeout
CHECK_TIMEOUT_INTERVAL=120000

# ==============================
# Bot limit
# ==============================

MAX_BOTS=20
